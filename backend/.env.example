# DORY API environment template.
# Copy to .env and fill in the blanks. Never commit .env or real secrets.
# Production values are listed in docs/SECURITY.md and docs/LOCAL_BACKEND_SETUP.md.

APP_NAME=DORY
APP_ENV=local
APP_KEY=
# Must be false in production: debug mode adds exception details to error responses.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL in production. For a local MariaDB server (e.g. XAMPP) use DB_CONNECTION=mariadb.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dory_db
DB_USERNAME=dory_app
DB_PASSWORD=

# The API is stateless (Sanctum bearer tokens), so no sessions are stored.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time updates: Laravel Reverb, self-hosted (docs/REVERB_SETUP.md).
# Generate your own id, key and secret (docs/REVERB_SETUP.md); never commit them.
# The key is public (the app needs it); the secret stays on the server.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where Laravel sends broadcasts (the Reverb server, seen from the API).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the Reverb server listens.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Browser origins allowed to connect ("*" = any). Mobile apps send no origin.
REVERB_ALLOWED_ORIGINS=*
# Single server: no Redis needed. Enable only with a configured Redis.
REVERB_SCALING_ENABLED=false
FILESYSTEM_DISK=local

# Cache and queues. Production: redis. Local fallback when Redis is not installed: database.
# Broadcasts and notifications are queued: run a worker
# (php artisan queue:work --queue=realtime,notifications,default).
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
# CACHE_PREFIX=

# Redis (phpredis extension in production; set REDIS_CLIENT=predis only if
# the predis/predis package is installed). For managed Redis with TLS and ACL
# users, use REDIS_URL=tls://username:password@host:port instead.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
# REDIS_URL=

# Sanctum API tokens: lifetime in minutes (43200 = 30 days) and secret-scanning prefix.
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=dory_

# Comma-separated web origins allowed by CORS. Mobile apps do not need CORS.
CORS_ALLOWED_ORIGINS=

# Target of the password reset email link (Flutter deep link or web page).
# ?token=...&email=... is appended.
PASSWORD_RESET_URL="${APP_URL}/reset-password"

# Requests per minute.
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=20
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3
RATE_LIMIT_INVITATIONS_PER_MINUTE=10
RATE_LIMIT_INVITATION_TOKEN_PER_MINUTE=30

# Team invitations. {token} is replaced by the invitation token. The
# default opens the DORY app through its registered "dory" URL scheme.
INVITATION_URL="dory://app/invitations/{token}"
INVITATION_EXPIRES_IN_DAYS=7
# Return the invitation link to the inviter for manual sharing. Defaults to
# true outside production. The link is a secret: it lets its holder join.
INVITATION_SHARE_LINKS=true
# Also email the link. Only takes effect with a real MAIL_MAILER (not "log"
# or "array"), so invitation tokens are never written to log files.
INVITATION_SEND_EMAILS=false

# Queue engine. {token} is replaced by the queue's public token; the default
# is the guest web page served by this backend, encoded in each queue's QR.
QUEUE_PUBLIC_JOIN_URL="${APP_URL}/join/{token}"
# Completed tickets needed before wait times come from history, and how many
# recent ones the average uses.
QUEUE_WAIT_HISTORY_MINIMUM=5
QUEUE_WAIT_HISTORY_SIZE=20
# Lifetime of the guest ticket cookie on the web page, in days.
QUEUE_GUEST_COOKIE_DAYS=2
RATE_LIMIT_QUEUE_JOIN_PER_MINUTE=10
RATE_LIMIT_QUEUE_PUBLIC_PER_MINUTE=60
RATE_LIMIT_QUEUE_OPERATIONS_PER_MINUTE=120

# Mail. "log" delivers nothing: emails are written to storage/logs/mail-*.log.
# Configure a real provider (SMTP, SES, Postmark, ...) before relying on email.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local demo accounts created by `php artisan db:seed`. Leave empty to skip.
# Never set in production.
SEED_DEMO_PASSWORD=

# Public discovery (docs/BUSINESS_DISCOVERY.md)
RATE_LIMIT_DISCOVERY_PER_MINUTE=120
DISCOVERY_DEFAULT_RADIUS_KM=10
DISCOVERY_MAX_RADIUS_KM=100
DISCOVERY_MAX_PER_PAGE=50
DISCOVERY_WAIT_CANDIDATES=200
DISCOVERY_MIN_RATINGS=3

# Notifications (docs/NOTIFICATION_EVENTS.md)
NOTIFY_ALMOST_TURN_PEOPLE_AHEAD=2

# Push notifications through Firebase Cloud Messaging (docs/FIREBASE_SETUP.md).
# Off until a Firebase project exists. FIREBASE_CREDENTIALS is the path of the
# service account JSON, kept OUTSIDE the repository, for example
# D:/dory-secrets/firebase-service-account.json. Never commit that file.
FCM_ENABLED=false
FIREBASE_CREDENTIALS=

# Subscriptions (docs/SUBSCRIPTIONS.md). Plans, prices and limits live in the
# database after the first migration; these are the defaults and switches.
BILLING_ENABLED=true
BILLING_DEFAULT_PLAN=free
BILLING_TRIAL_PLAN=pro
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_ONCE_PER_OWNER=true
BILLING_GRACE_DAYS=7
BILLING_CURRENCY=USD
BILLING_CHECKOUT_EXPIRES_MINUTES=60

# Online payments (docs/PAYMENTS.md). "none": no online payment; platform
# admins record bank transfers, cash and mobile wallet payments.
# "mastercard": Mastercard Gateway through an acquiring bank. The merchant id,
# API password and notification secret come from the bank's merchant portal.
# Keep them only in the server's .env, never in the repository.
PAYMENT_PROVIDER=none
MPGS_GATEWAY_URL=
MPGS_API_VERSION=100
MPGS_MERCHANT_ID=
MPGS_API_PASSWORD=
MPGS_NOTIFICATION_SECRET=
MPGS_MERCHANT_NAME=DORY
